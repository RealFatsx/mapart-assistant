            if (!state.method_26215() && state.method_28498(net.minecraft.class_2741.field_12481)) {
                net.minecraft.class_2350 facing = state.method_11654(net.minecraft.class_2741.field_12481);
                int targetX = cx + facing.method_10148();
                int targetZ = cz + facing.method_10165();
                
                int floorY = cy;
                while (floorY > cy - 20 && client.field_1687.method_8320(new net.minecraft.class_2338(targetX, floorY - 1, targetZ)).method_26215()) {
                    floorY--;
