                boolean isBaritoneActive = false;
                try {
                    Class<?> apiClass = Class.forName("baritone.api.BaritoneAPI");
                    Object provider = apiClass.getMethod("getProvider").invoke(null);
                    Object primaryBaritone = provider.getClass().getMethod("getPrimaryBaritone").invoke(provider);
                    Object customGoalProcess = primaryBaritone.getClass().getMethod("getCustomGoalProcess").invoke(primaryBaritone);
                    Object pathingControlManager = primaryBaritone.getClass().getMethod("getPathingControlManager").invoke(primaryBaritone);
                    boolean isActive = (boolean) customGoalProcess.getClass().getMethod("isActive").invoke(customGoalProcess);
                    boolean hasPath = (boolean) pathingControlManager.getClass().getMethod("hasPath").invoke(pathingControlManager);
                    isBaritoneActive = isActive || hasPath;
                } catch (Exception e) {}
                
                if (!currentChestFrontFound && client.field_1724.field_6012 % 10 == 0) {
                    sendChestGoto(currentChest.x, currentChest.y, currentChest.z);
                }
                
                if (!isBaritoneActive) {
                    double dist = client.field_1724.method_5649(currentChest.x + 0.5, currentChest.y + 0.5, currentChest.z + 0.5);
                    if (dist < 25.0) { // Within 5 blocks (Baritone goal reached)
                        // Face chest and interact
                        double dX = currentChest.x + 0.5 - client.field_1724.method_23317();
                        double dY = currentChest.y + 0.5 - (client.field_1724.method_23318() + client.field_1724.method_5751());
                        double dZ = currentChest.z + 0.5 - client.field_1724.method_23321();
                        client.field_1724.method_36456((float) (Math.atan2(dZ, dX) * 180.0D / Math.PI) - 90.0F);
                        client.field_1724.method_36457((float) -(Math.atan2(dY, Math.sqrt(dX * dX + dZ * dZ)) * 180.0D / Math.PI));
                        
                        if (System.currentTimeMillis() - stateWaitStart > 300) {
                            net.minecraft.class_3965 hitResult = new net.minecraft.class_3965(
                                new net.minecraft.class_243(currentChest.x + 0.5, currentChest.y + 0.5, currentChest.z + 0.5),
                                net.minecraft.class_2350.field_11036,
                                new net.minecraft.class_2338(currentChest.x, currentChest.y, currentChest.z),
                                false
                            );
                            client.field_1761.method_2896(client.field_1724, net.minecraft.class_1268.field_5808, hitResult);
                            
                            state = State.RESTOCKING;
                            restockSlotIndex = 0;
                            stateWaitStart = System.currentTimeMillis();
                        }
                    } else if (System.currentTimeMillis() - stateWaitStart > 5000) {
                        log("§cFailed to reach chest! Resuming pathing...");
                        state = State.PATHING_TO_WAYPOINT;
                        stateWaitStart = System.currentTimeMillis();
                    }
                } else {
                    stateWaitStart = System.currentTimeMillis();
                }
                break;
            case RESTOCKING:
                if (client.field_1755 instanceof net.minecraft.class_476) {
                    if (chestOpenTime == 0) chestOpenTime = System.currentTimeMillis();
                    
                    net.minecraft.class_476 screen = (net.minecraft.class_476) client.field_1755;
                    net.minecraft.class_1703 menu = screen.method_17577();
                    
                    class_2960 targetRl = class_2960.method_60654(chests.get(currentChestIndex).blockId);
                    
                    if (System.currentTimeMillis() - chestOpenTime > 400) {
                        int currentlyHave = getInventoryCount(client, targetRl.toString());
                        if (currentlyHave >= currentPassTotalBlocksNeeded || !hasInventorySpace(client, targetRl.toString())) {
                            log("§aSmart Restock complete or inventory full! Have " + currentlyHave + "/" + currentPassTotalBlocksNeeded + " needed blocks.");
                            client.field_1724.method_7346();
                            client.method_1507(null);
                            state = State.PATHING_TO_WAYPOINT;
                            stateWaitStart = System.currentTimeMillis();
                            chestOpenTime = 0;
                            return;
                        }

                        boolean clicked = false;
                        int slotsChecked = 0;
                        int totalChestSlots = menu.field_7761.size() - 36;
                        
                        while (slotsChecked < totalChestSlots) {
                            if (restockSlotIndex >= totalChestSlots) restockSlotIndex = 0; // Loop around
                            
                            net.minecraft.class_1735 slot = menu.field_7761.get(restockSlotIndex);
                            restockSlotIndex++;
                            slotsChecked++;
                            
                            if (slot.method_7681() && class_7923.field_41178.method_10221(slot.method_7677().method_7909()).equals(targetRl)) {
