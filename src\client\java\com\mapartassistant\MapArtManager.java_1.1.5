                                clicked = true;
                                break;
                            }
                        }
                        
                        if (!clicked) {
                            log("§eRestock finished (chest empty of this block). Checking if enough blocks obtained...");
                            client.field_1724.method_7346();
                            client.method_1507(null);
                            chestOpenTime = 0;
                            
                            if (!hasRequiredBlock(client, targetRl.toString())) {
                                currentChest = chests.get(currentChestIndex);
                                net.minecraft.class_2338 abovePos = new net.minecraft.class_2338(currentChest.x, currentChest.y + 1, currentChest.z);
