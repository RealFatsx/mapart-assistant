                            Object provider = apiClass.getMethod("getProvider").invoke(null);
                            Object primaryBaritone = provider.getClass().getMethod("getPrimaryBaritone").invoke(provider);
                            Object customGoalProcess = primaryBaritone.getClass().getMethod("getCustomGoalProcess").invoke(primaryBaritone);
                            Object pathingControlManager = primaryBaritone.getClass().getMethod("getPathingControlManager").invoke(primaryBaritone);
                            
                            boolean isActive = (boolean) customGoalProcess.getClass().getMethod("isActive").invoke(customGoalProcess);
                            boolean hasPath = (boolean) pathingControlManager.getClass().getMethod("hasPath").invoke(pathingControlManager);
                            
                            // If we are waiting for Baritone but Baritone is completely idle
                            if (!isActive && !hasPath) {
                                log("§eBaritone got stuck or finished early. Skipping to next waypoint...");
                                currentPathIndex++;
                                if (currentPathIndex < currentPathWaypoints.size()) {
                                    int[] nextWp = currentPathWaypoints.get(currentPathIndex);
                                    sendBaritoneGoto(nextWp[0], nextWp[1], nextWp[2]);
                                } else {
                                    ChestEntry targetChest = chests.get(currentChestIndex);
                                    currentChestFrontFound = false;
                                    sendChestGoto(targetChest.x, targetChest.y, targetChest.z);
                                    state = State.RETURNING_TO_CHEST;
                                    log("§aFinished color! Returning to chest to deposit leftovers...");
                                }
                            }
                        } catch (Exception e) {}
                    }
                }
                break;
            case RETURNING_TO_CHEST:
                ChestEntry returnChest = chests.get(currentChestIndex);
                
                boolean isBaritoneActiveRet = false;
                try {
                    Class<?> apiClass = Class.forName("baritone.api.BaritoneAPI");
                    Object provider = apiClass.getMethod("getProvider").invoke(null);
                    Object primaryBaritone = provider.getClass().getMethod("getPrimaryBaritone").invoke(provider);
                    Object customGoalProcess = primaryBaritone.getClass().getMethod("getCustomGoalProcess").invoke(primaryBaritone);
                    Object pathingControlManager = primaryBaritone.getClass().getMethod("getPathingControlManager").invoke(primaryBaritone);
                    boolean isActive = (boolean) customGoalProcess.getClass().getMethod("isActive").invoke(customGoalProcess);
                    boolean hasPath = (boolean) pathingControlManager.getClass().getMethod("hasPath").invoke(pathingControlManager);
                    isBaritoneActiveRet = isActive || hasPath;
                } catch (Exception e) {}
                
                if (!currentChestFrontFound && client.field_1724.field_6012 % 10 == 0) {
