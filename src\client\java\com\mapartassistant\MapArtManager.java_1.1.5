    private static void sendBaritoneGoto(int x, int y, int z) {
        try {
            Class<?> apiClass = Class.forName("baritone.api.BaritoneAPI");
            Object provider = apiClass.getMethod("getProvider").invoke(null);
            Object primaryBaritone = provider.getClass().getMethod("getPrimaryBaritone").invoke(provider);
            Object customGoalProcess = primaryBaritone.getClass().getMethod("getCustomGoalProcess").invoke(primaryBaritone);
            
            Class<?> goalBlockClass = Class.forName("baritone.api.pathing.goals.GoalBlock");
            Object goalBlock = goalBlockClass.getConstructor(int.class, int.class, int.class).newInstance(x, y, z);
            
            customGoalProcess.getClass().getMethod("setGoal", Class.forName("baritone.api.pathing.goals.Goal")).invoke(customGoalProcess, goalBlock);
            customGoalProcess.getClass().getMethod("path").invoke(customGoalProcess);
        } catch (Exception e) {
            System.err.println("[MapArt] Baritone API failed: " + e.getMessage());
        }
    }

    private static void cancelBaritone() {
        try {
            Class<?> apiClass = Class.forName("baritone.api.BaritoneAPI");
            Object provider = apiClass.getMethod("getProvider").invoke(null);
            Object primaryBaritone = provider.getClass().getMethod("getPrimaryBaritone").invoke(provider);
            
            try {
                Object pathingBehavior = primaryBaritone.getClass().getMethod("getPathingBehavior").invoke(primaryBaritone);
                pathingBehavior.getClass().getMethod("cancelEverything").invoke(pathingBehavior);
            } catch (Exception e) {}
            
            try {
                Object customGoalProcess = primaryBaritone.getClass().getMethod("getCustomGoalProcess").invoke(primaryBaritone);
                customGoalProcess.getClass().getMethod("setGoal", Class.forName("baritone.api.pathing.goals.Goal")).invoke(customGoalProcess, new Object[]{null});
            } catch (Exception e) {}
            
            try {
                Object commandManager = primaryBaritone.getClass().getMethod("getCommandManager").invoke(primaryBaritone);
                commandManager.getClass().getMethod("execute", String.class).invoke(commandManager, "stop");
            } catch (Exception e) {}
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

